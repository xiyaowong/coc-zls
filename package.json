{
  "name": "coc-zls",
  "type": "module",
  "version": "0.0.7",
  "description": "Zig Language Server (zls) extension for coc.nvim.",
  "author": "wongxy <xiyao.wong@foxmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiyaowong/coc-zls"
  },
  "keywords": [
    "coc.nvim"
  ],
  "main": "lib/index.js",
  "engines": {
    "coc": "^0.0.80",
    "node": ">=22.0.0"
  },
  "activationEvents": [
    "onLanguage:zig"
  ],
  "contributes": {
    "configuration": {
      "title": "Zig Language Server",
      "properties": {
        "zls.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Specifies the path of the zls executable, or a command name available on PATH. When set, no download happens."
        },
        "zls.checkUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Whether to check for a newer zls release after startup."
        },
        "zls.logFile": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to the zls log file. Passed to the language server as --log-file."
        },
        "zls.logLevel": {
          "type": "string",
          "enum": [
            "err",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "The log level used by zls. Passed to the language server as --log-level."
        },
        "zls.disableLspLogs": {
          "type": "boolean",
          "default": false,
          "description": "Disable zls's LSP window/logMessage messages. Passed to the language server as --disable-lsp-logs."
        },
        "zls.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Whether zls provides Zig formatting. When false, coc will not use zls as a formatter."
        }
      }
    },
    "commands": [
      {
        "command": "zls.reinstall",
        "title": "Reinstall zls",
        "category": "Zig Language Server"
      },
      {
        "command": "zls.restart",
        "title": "Restart zls",
        "category": "Zig Language Server"
      },
      {
        "command": "zls.stop",
        "title": "Stop zls",
        "category": "Zig Language Server"
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "tsdown"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@wongxy/eslint-config": "^4.0.1",
    "coc.nvim": "^0.0.83-next.27",
    "eslint": "^10.10.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
